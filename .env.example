# 复制为 .env 后填写真实值
# Foundry 1.x 已移除 ${VAR} 插值，用 FOUNDRY_RPC_ENDPOINTS 覆盖 [rpc_endpoints]
# 多个别名时必须用单引号包住整个 TOML table，否则逗号会被 dotenv 截断
FOUNDRY_RPC_ENDPOINTS='{sepolia="https://sepolia.gateway.tenderly.co", mainnet="https://mainnet.gateway.tenderly.co", op_sepolia="https://sepolia.optimism.io", xlayer_testnet="https://testrpc.xlayer.tech/terigon", local="http://127.0.0.1:8545", anvil1="http://127.0.0.1:8545", anvil2="http://127.0.0.1:8546"}'

SEPOLIA_PRIVATE_KEY=

# 泄漏地址抢救演练。两把私钥都只放在 .env，不要写进源码或命令行。
# 赞助者支付 gas 并接收资产。受害者余额必须是 0，不要给它领水龙头。
# 本地 anvil 可用公开测试私钥；Sepolia 换自己的测试私钥。不要使用持有真实资产的私钥。
RESCUE_SPONSOR_KEY=
RESCUE_VICTIM_KEY=

ETHERSCAN_API_KEY=