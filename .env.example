# 复制为 .env 后填写真实值
# Foundry 1.x 已移除 ${VAR} 插值，用 FOUNDRY_RPC_ENDPOINTS 覆盖 [rpc_endpoints]
# 多个别名时必须用单引号包住整个 TOML table，否则逗号会被 dotenv 截断
FOUNDRY_RPC_ENDPOINTS='{sepolia="https://sepolia.gateway.tenderly.co", mainnet="https://mainnet.gateway.tenderly.co", op_sepolia="https://op-sepolia-testnet.api.pocket.network"}'

SEPOLIA_PRIVATE_KEY=

ETHERSCAN_API_KEY=